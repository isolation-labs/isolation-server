{
  "name": "isolation-server",
  "version": "0.0.2",
  "description": "The Isolation server: the light layer between Isolation Cloud and an OpenSandbox runtime — pairing, tunnel, view-auth doorman, secrets, workspace persistence.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "isolation-server": "dist/cli.js",
    "isolation": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-editor.mjs",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "http-proxy-3": "^1.20.5"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.56.0",
    "preact": "^10.29.8",
    "typescript": "^5.6.0",
    "zustand": "^5.0.15"
  },
  "files": [
    "dist"
  ]
}

{
  "name": "isolation-server",
  "version": "0.0.1",
  "description": "The Isolation server: the light layer between Isolation Cloud and an OpenSandbox runtime \u2014 pairing, tunnel, view-auth doorman, secrets, workspace persistence.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "isolation-server": "dist/cli.js",
    "isolation": "dist/cli.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "http-proxy-3": "^1.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist"
  ]
}
